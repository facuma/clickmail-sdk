{
  "name": "@clickmail/sdk",
  "version": "0.3.0",
  "description": "TypeScript SDK for ClickMail — transactional and broadcast email API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./webhook": {
      "import": {
        "types": "./dist/webhook.d.ts",
        "default": "./dist/webhook.js"
      },
      "require": {
        "types": "./dist/webhook.d.cts",
        "default": "./dist/webhook.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "keywords": [
    "email",
    "transactional-email",
    "broadcast-email",
    "ses",
    "sdk",
    "typescript",
    "clickmail",
    "api-client"
  ],
  "author": "ClickMail",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/facuma/clickmail-sdk.git"
  },
  "homepage": "https://github.com/facuma/clickmail-sdk#readme",
  "bugs": {
    "url": "https://github.com/facuma/clickmail-sdk/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "tsup": "^8.1.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
